flowchart LR
    subgraph Ingress["1. Wire & ERP Ingress"]
        PG["Raw PG 3.0 TCP Stream\nmsg='Q' length SQL\\0"] --> WIRE["apodictic-wire-proxy\nWireCodec::decode()"]
        ODOO_IN["Odoo 18 JSON-RPC\naccount.move.create"] --> DLP
        NS_IN["NetSuite SuiteTalk\nVendorBill / Journal"] --> DLP
        SAP_IN["SAP S/4HANA OData\nA_SupplierInvoice"] --> DLP
