    WIRE --> DLP["2. ZeroPIIGateway\nIBAN/TaxID/Card -> <SYM_*>\n0.013ms P50 (Bijective Vault)"]

    DLP --> PARSE["3. SqlAstCompiler & SSA Lifter\nExtract tables, deltas, WHERE bounds"]
    PARSE --> Z3["4. apodictic-z3-engine (Z3 5.4.1)\nQF_LRA Solvency + VAT + SoD\n3-Way Match + Basel III Optimize"]

    Z3 -->|"UNSAT + unsat_core"| BLOCK["VETO BEFORE COMMIT\n- PG Wire 'E' SQLSTATE 40001/42501\n- Odoo account.move.reversal\n- Compensating SQL Witness Patch"]
    Z3 -->|"SAT + SHA-256 Proof"| COMMIT["STAGE ATOMIC COMPENSATOR\n- SQL SAVEPOINT (<38ms SLA)\n- ISO 20022 pain.001 Clearing"]

    BLOCK --> VAULT["5. apodictic-audit-vault\nSEC 17a-4 Forward Hash Chain\n+ ECDSA P-256 Signatures\n+ SQL:2011 Bi-Temporal Snapshot"]
    COMMIT --> VAULT
